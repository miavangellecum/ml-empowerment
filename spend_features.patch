+    cur.execute("DELETE FROM plaid_transactions WHERE item_id = ?", (item_id,))
+    cur.execute("DELETE FROM plaid_accounts WHERE item_id = ?", (item_id,))
+    cur.execute("DELETE FROM plaid_items WHERE item_id = ?", (item_id,))
+    conn.commit()
+    conn.close()
