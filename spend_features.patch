+  modal.className = "banks-modal";
+  modal.innerHTML = `
+    <div class="banks-modal-backdrop"></div>
+    <div class="banks-modal-panel">
+      <div class="banks-modal-head">
+        <h3>Linked banks</h3>
+        <button type="button" class="banks-modal-close" aria-label="Close">✕</button>
